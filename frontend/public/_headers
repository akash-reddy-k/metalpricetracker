# Cache hashed JS/CSS assets for 1 year (immutable — filename changes on rebuild)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache images and static files
/favicon.svg
  Cache-Control: public, max-age=86400
/og-image.png
  Cache-Control: public, max-age=86400

# HTML pages — revalidate every time for fresh content
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Sitemap and robots — revalidate daily
/sitemap.xml
  Cache-Control: public, max-age=86400
/robots.txt
  Cache-Control: public, max-age=86400
